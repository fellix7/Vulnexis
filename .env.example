# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional extra keys (each key has its own free quota); used when the one above is out of quota
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# Port for the API server
PORT=8787
# Network: only needed when every scan fails on a college / office network (see the Connection check
# printed when the server starts, or on the scan page after a failure).
# The proxy your browser uses, e.g. http://proxy.college.edu:3128
# HTTPS_PROXY=
# A network that inspects HTTPS: path to its certificate file (.pem), from the network admin
# NODE_EXTRA_CA_CERTS=
# Set to 1 to serve OSV/EPSS responses only from data/snapshots (demo without network)
OFFLINE=0
# Gemini model used for advisory analysis (default: gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite
# Gemini requests per minute. 4 fits the free tier (5/min per model); raise it (e.g. 60) with a paid key
GEMINI_RPM=4

# Optional: a GitHub token (no scopes needed) raises the GitHub API limit used for repo stars/contributors
# from 60 to 5,000 requests an hour. Without it Vulnexis still works; the counts are just left out when limited.
# GITHUB_TOKEN=

# Scan limits (defaults shown)
# MAX_CONCURRENT_SCANS=4
# MAX_QUEUED_SCANS=40
# MAX_SCANS_PER_CLIENT=2
# SCAN_DEADLINE_MS=180000
# SCAN_RATE_PER_MIN=6
# SCAN_RATE_PER_DAY=100
