# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional extra keys (each key has its own free quota); used when the one above is out of quota
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# Port for the API server
PORT=8787
# Network: only needed when every scan fails on a college / office network (see the Connection check
# printed when the server starts, or on the scan page after a failure).
# The proxy your browser uses, e.g. http://proxy.college.edu:3128
# HTTPS_PROXY=
# A network that inspects HTTPS: path to its certificate file (.pem), from the network admin
# NODE_EXTRA_CA_CERTS=
# Set to 1 to serve OSV/EPSS responses only from data/snapshots (demo without network)
OFFLINE=0
# Gemini model used for advisory analysis (default: gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite
# Gemini requests per minute. 4 fits the free tier (5/min per model); raise it (e.g. 60) with a paid key
GEMINI_RPM=4

# Optional: a GitHub token (no scopes needed) raises the GitHub API limit used for repo stars/contributors
# from 60 to 5,000 requests an hour. Without it Vulnera still works; the counts are just left out when limited.
# GITHUB_TOKEN=

# Scan limits (defaults shown)
# MAX_CONCURRENT_SCANS=4
# MAX_QUEUED_SCANS=40
# MAX_SCANS_PER_CLIENT=2
# SCAN_DEADLINE_MS=180000
# SCAN_RATE_PER_MIN=6
# SCAN_RATE_PER_DAY=100

# AI code check pacing. GEMINI_RPM is calls per minute per key (4 suits the free tier; use 60 or more on a paid key).
# GEMINI_RPM=4
# Longest a scan waits for a free AI slot before skipping the rest of the code check (ms), and the most AI calls per scan.
# AI_MAX_WAIT_MS=60000
# AI_MAX_CALLS_PER_SCAN=20

# ---- Accounts (optional). Unset DATABASE_URL = no accounts: Vulnera runs as a single-user tool, exactly as before. ----
# Accounts need all of: DATABASE_URL, GITHUB_CLIENT_ID + GITHUB_CLIENT_SECRET, and PUBLIC_ORIGIN (in production).
# Postgres (on Supabase use the session pooler, port 5432, not the transaction pooler on 6543)
# DATABASE_URL=postgres://user:password@host:5432/dbname
# TLS: a remote database is ALWAYS verified (certificate and host name). Without a CA setting below, Node's default trust
# store is used. Supabase uses its own CA: download the CA certificate from the Supabase dashboard (Project settings,
# Database, SSL configuration) and point DATABASE_CA_FILE at it (or paste the PEM text into DATABASE_CA_CERT).
# sslmode= and other ssl* parameters in DATABASE_URL are ignored (the server logs it). Local databases use no TLS.
# DATABASE_CA_FILE=/etc/ssl/certs/supabase-prod-ca-2021.crt
# DATABASE_CA_CERT=
# DATABASE_SSL=1   (0 turns TLS off for a local or development database; refused for a remote one in production)
# DB_POOL_MAX=5
# Apply pending migrations when the server starts (set 0 to run "npm run migrate -w server" yourself)
# MIGRATE_ON_START=1
# The site's public address; sign-in callback is ${PUBLIC_ORIGIN}/auth/github/callback
# PUBLIC_ORIGIN=https://vulnera.example.com
# In production, with DATABASE_URL set, PUBLIC_ORIGIN (https), GITHUB_CLIENT_ID and GITHUB_CLIENT_SECRET are all required: the server refuses to start without them.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# SESSION_TTL_DAYS=30
# Saved scans are deleted after this many days
# SCAN_RETENTION_DAYS=90
# Failed API key lookups allowed per IP per minute
# AUTH_FAIL_PER_MIN=20
# Monthly Gemini budget in rupees (0 = no cap). The AI code check pauses when the estimated spend reaches it.
# GEMINI_MONTHLY_BUDGET_INR=0
# In production, set it whenever GEMINI_API_KEY is set (the server warns at startup if not). If the budget cannot be read
# from the database on a cold start, the AI check pauses rather than spend without a cap.
# Estimated rupees per million tokens: confirm against current Gemini pricing
# GEMINI_INR_PER_1M_INPUT=9
# GEMINI_INR_PER_1M_OUTPUT=36
# Number of reverse proxies in front of the server (Cloudflare + host = 2). Wrong values share one anonymous quota or let it be spoofed.
# TRUST_PROXY=0
# Behind Cloudflare, read the visitor's address from its header, but only for requests that really come from Cloudflare:
# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
# TRUSTED_PROXY_CIDRS=<Cloudflare's published ranges, comma-separated, IPv4 and IPv6: https://www.cloudflare.com/ips/>
# The header is ignored when the connection does not come from one of these ranges. IPv6 visitors are limited per /64.
